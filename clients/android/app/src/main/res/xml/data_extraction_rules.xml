<?xml version="1.0" encoding="utf-8"?>
<!-- Session-Token und Krypto-Store nie in Cloud-Backup oder Geraetetransfer aufnehmen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
